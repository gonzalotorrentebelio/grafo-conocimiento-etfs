@prefix ex: <http://ejemplo.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:IE00B4K48X80 a ex:ETF ;
    rdfs:label "iShares Core MSCI Europe UCITS ETF" ;
    ex:contiene ex:ASML,
        ex:AZN,
        ex:HSBA,
        ex:NESN,
        ex:NOVN,
        ex:ROG,
        ex:SAN,
        ex:SAP,
        ex:SHEL,
        ex:SIE ;
    ex:fechaDatos "2026-09-30"^^xsd:date ;
    ex:fuente "https://www.trackinsight.com/en/fund/SMEA/holdings"^^xsd:anyURI ;
    ex:isin "IE00B4K48X80" .

ex:IE00B4L5Y983 a ex:ETF ;
    rdfs:label "iShares Core MSCI World UCITS ETF" ;
    ex:contiene ex:AAPL,
        ex:AMZN,
        ex:AVGO,
        ex:GOOGL,
        ex:META,
        ex:MSFT,
        ex:MU,
        ex:NVDA,
        ex:TSLA ;
    ex:fechaDatos "2026-09-18"^^xsd:date ;
    ex:fuente "https://stockanalysis.com/quote/lon/SWDA/holdings/"^^xsd:anyURI ;
    ex:isin "IE00B4L5Y983" .

ex:IE00B5BMR087 a ex:ETF ;
    rdfs:label "iShares Core S&P 500 UCITS ETF" ;
    ex:contiene ex:AAPL,
        ex:AMZN,
        ex:AVGO,
        ex:GOOGL,
        ex:META,
        ex:MSFT,
        ex:MU,
        ex:NVDA,
        ex:TSLA ;
    ex:fechaDatos "2026-09-11"^^xsd:date ;
    ex:fuente "https://stockanalysis.com/quote/lon/CSP1/holdings/"^^xsd:anyURI ;
    ex:isin "IE00B5BMR087" .

ex:codigoISO a owl:DatatypeProperty ;
    rdfs:label "código ISO"@es ;
    rdfs:domain ex:Pais ;
    rdfs:range xsd:string .

ex:contiene a owl:ObjectProperty ;
    rdfs:label "contiene"@es ;
    rdfs:domain ex:ETF ;
    rdfs:range ex:Empresa .

ex:fechaDatos a owl:DatatypeProperty ;
    rdfs:label "fecha de los datos"@es ;
    rdfs:comment "Fecha de la ficha oficial de la que salen las posiciones. Es la clave de la trazabilidad."@es ;
    rdfs:domain ex:ETF ;
    rdfs:range xsd:date .

ex:fuente a owl:DatatypeProperty ;
    rdfs:label "fuente"@es ;
    rdfs:comment "Página web de la que salen las posiciones del ETF. Junto con fechaDatos, permite rastrear cada dato hasta su origen."@es ;
    rdfs:domain ex:ETF ;
    rdfs:range xsd:anyURI .

ex:isin a owl:DatatypeProperty ;
    rdfs:label "ISIN"@es ;
    rdfs:domain ex:ETF ;
    rdfs:range xsd:string .

ex:ontologia a owl:Ontology ;
    rdfs:label "Ontología de ETFs"@es ;
    rdfs:comment "Modela qué empresas contienen los ETFs y en qué sector y país están."@es .

ex:perteneceA a owl:ObjectProperty ;
    rdfs:label "pertenece a"@es ;
    rdfs:domain ex:Empresa ;
    rdfs:range ex:Sector .

ex:ticker a owl:DatatypeProperty ;
    rdfs:label "ticker"@es ;
    rdfs:domain ex:Empresa ;
    rdfs:range xsd:string .

ex:tieneSedeEn a owl:ObjectProperty ;
    rdfs:label "tiene sede en"@es ;
    rdfs:domain ex:Empresa ;
    rdfs:range ex:Pais .

ex:ASML a ex:Empresa ;
    rdfs:label "ASML Holding NV" ;
    ex:perteneceA ex:InformationTechnology ;
    ex:ticker "ASML" ;
    ex:tieneSedeEn ex:NL .

ex:AZN a ex:Empresa ;
    rdfs:label "AstraZeneca plc" ;
    ex:perteneceA ex:HealthCare ;
    ex:ticker "AZN" ;
    ex:tieneSedeEn ex:GB .

ex:ConsumerStaples a ex:Sector ;
    rdfs:label "Consumer Staples" .

ex:ES a ex:Pais ;
