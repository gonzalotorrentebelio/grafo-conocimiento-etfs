    rdfs:label "Alemania"@es ;
    ex:codigoISO "DE" .

ex:Financials a ex:Sector ;
    rdfs:label "Financials" .

ex:GOOGL a ex:Empresa ;
    rdfs:label "Alphabet Inc." ;
    ex:perteneceA ex:CommunicationServices ;
    ex:ticker "GOOGL" ;
    ex:tieneSedeEn ex:US .

