ex:CH a ex:Pais ;
    rdfs:label "Suiza"@es ;
    ex:codigoISO "CH" .

ex:GB a ex:Pais ;
    rdfs:label "Reino Unido"@es ;
    ex:codigoISO "GB" .

ex:HealthCare a ex:Sector ;
    rdfs:label "Health Care" .

ex:ETF a owl:Class ;
    rdfs:label "ETF"@es ;
    rdfs:comment "Fondo cotizado. Se identifica por su ISIN."@es .

ex:InformationTechnology a ex:Sector ;
    rdfs:label "Information Technology" .

ex:Pais a owl:Class ;
    rdfs:label "País"@es ;
    rdfs:comment "País de la sede. Se identifica por su código ISO de 2 letras."@es .

ex:Sector a owl:Class ;
    rdfs:label "Sector"@es ;
    rdfs:comment "Uno de los 11 sectores de la clasificación GICS."@es .

ex:US a ex:Pais ;
    rdfs:label "Estados Unidos"@es ;
    ex:codigoISO "US" .

ex:Empresa a owl:Class ;
    rdfs:label "Empresa"@es ;
    rdfs:comment "Compañía cotizada. Se identifica por su ticker."@es .

